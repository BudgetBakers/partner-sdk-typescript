{
  "name": "@budgetbakers/partner-sdk",
  "version": "0.2.0",
  "description": "BudgetBakers Partner API server SDK (AISP): typed client, webhooks verification, hosted connect sessions.",
  "license": "Apache-2.0",
  "homepage": "https://aisp-docs.bbapi.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BudgetBakers/partner-sdk-typescript.git"
  },
  "bugs": {
    "email": "integration@budgetbakers.com"
  },
  "keywords": [
    "budgetbakers",
    "open-banking",
    "aisp",
    "psd2",
    "partner-api",
    "webhooks"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "partner-sdk-conformance": "dist/conformance/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.10.2",
    "eslint": "9.39.5",
    "globals": "15.15.0",
    "tsup": "8.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.64.0",
    "vitest": "2.1.9"
  }
}
